<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Bamboo: 3-5 IRL years. Fast-growing grass, poor lumber -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Plant_TreeBamboo"]/plant/growDays</xpath>
		<value><growDays>11</growDays></value>
	</Operation>

	<!-- Cocoa: 3-5 IRL years. Tropical crop tree (yields chocolate) -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Plant_TreeCocoa"]/plant/growDays</xpath>
		<value><growDays>11</growDays></value>
	</Operation>

