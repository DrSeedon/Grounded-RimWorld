<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationFindMod">
          <mods>
            <li>Odyssey</li>
          </mods>
          <nomatch Class="PatchOperationSequence">
            <operations>
              
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeDodgeChance</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeDodgeChance</xpath>
                  <value>
                    <MeleeDodgeChance>0.3</MeleeDodgeChance>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                  <value>
                    <MeleeDodgeChance>0.3</MeleeDodgeChance>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeCritChance</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeCritChance</xpath>
                  <value>
                    <MeleeCritChance>0.35</MeleeCritChance>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                  <value>
                    <MeleeCritChance>0.35</MeleeCritChance>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeParryChance</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/MeleeParryChance</xpath>
                  <value>
                    <MeleeParryChance>0.05</MeleeParryChance>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                  <value>
                    <MeleeParryChance>0.05</MeleeParryChance>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Sharp</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Sharp</xpath>
                  <value>
                    <ArmorRating_Sharp>0.11</ArmorRating_Sharp>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                  <value>
                    <ArmorRating_Sharp>0.11</ArmorRating_Sharp>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Blunt</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Blunt</xpath>
                  <value>
                    <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases</xpath>
                  <value>
                    <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/comps</xpath>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]</xpath>
                  <value>
                    <comps />
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]</xpath>
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]/Durability</xpath>
                  <value>
                    <Durability>725</Durability>
                  </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/comps</xpath>
                  <value>
                    <li Class="CombatExtended.CompProperties_ArmorDurability">
                      <Durability>725</Durability>
                      <Regenerates>true</Regenerates>
                      <RegenInterval>600</RegenInterval>
                      <RegenValue>5</RegenValue>
                      <MinArmorPct>0.5</MinArmorPct>
                    </li>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]</xpath>
                <match Class="PatchOperationSequence">
                  <operations>
                    <li Class="PatchOperationConditional">
                      <xpath>Defs/ThingDef[defName="AEXP_Panda"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]/bodyShape</xpath>
                      <match Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[defName="AEXP_Panda"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]/bodyShape</xpath>
                        <value>
                          <bodyShape>Quadruped</bodyShape>
                        </value>
                      </match>
                      <nomatch Class="PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName="AEXP_Panda"]/modExtensions/li[@Class="CombatExtended.RacePropertiesExtensionCE"]</xpath>
                        <value>
                          <bodyShape>Quadruped</bodyShape>
                        </value>
                      </nomatch>
                    </li>
                  </operations>
                </match>
                <nomatch Class="PatchOperationAddModExtension">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]</xpath>
                  <value>
                    <li Class="CombatExtended.RacePropertiesExtensionCE">
                      <bodyShape>Quadruped</bodyShape>
                    </li>
                  </value>
                </nomatch>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>/Defs/ThingDef[defName="AEXP_Panda"]/tools</xpath>
                <match Class="PatchOperationRemove">
                  <xpath>/Defs/ThingDef[defName="AEXP_Panda"]/tools</xpath>
                </match>
              </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]</xpath>
                <value>
                  <tools>
                    <li Class="CombatExtended.ToolCE">
                      <label>head</label>
                      <capacities>
                        <li>Blunt</li>
                      </capacities>
                      <power>3.5</power>
                      <armorPenetrationBlunt>3</armorPenetrationBlunt>
                      <cooldownTime>1.65</cooldownTime>
                      <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                      <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                      <chanceFactor>0.2</chanceFactor>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>left claw</label>
                      <labelNoLocation>claw</labelNoLocation>
                      <capacities>
                        <li>Scratch</li>
                      </capacities>
                      <power>14.5</power>
                      <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.19</armorPenetrationSharp>
                      <cooldownTime>1.5</cooldownTime>
                      <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>right claw</label>
                      <labelNoLocation>claw</labelNoLocation>
                      <capacities>
                        <li>Scratch</li>
                      </capacities>
                      <power>14.5</power>
                      <armorPenetrationBlunt>3.8</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.19</armorPenetrationSharp>
                      <cooldownTime>1.5</cooldownTime>
                      <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
                    </li>
                    <li Class="CombatExtended.ToolCE">
                      <label>canines</label>
                      <capacities>
                        <li>Bite</li>
                      </capacities>
                      <power>17</power>
                      <armorPenetrationBlunt>5.75</armorPenetrationBlunt>
                      <armorPenetrationSharp>0.29</armorPenetrationSharp>
                      <cooldownTime>2.2</cooldownTime>
                      <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                    </li>
                  </tools>
                </value>
              </li>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Heat</xpath>
                <match Class="PatchOperationRemove">
                  <xpath>Defs/ThingDef[defName="AEXP_Panda"]/statBases/ArmorRating_Heat</xpath>
                </match>
              </li>
            </operations>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>